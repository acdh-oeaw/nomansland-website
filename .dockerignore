# Build context allowlist.
**

!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!astro.config.ts
!keystatic.config.tsx
!tsconfig.json
!.gitignore

!src/**
!content/**
!public/**
!scripts/prune-assets.ts

# Runtime configuration is copied separately from application sources.
!Caddyfile

# Restore only reusable Astro images, never installed dependencies.
!node_modules/.astro/assets/**
