{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"printWidth": 100,
	"proseWrap": "always",
	"sortPackageJson": false,
	"astro": {},
	"associations": [
		{
			"files": ["*.astro"],
			"language": "astro"
		}
	],
	"ignorePatterns": [
		"pnpm-lock.yaml",
		"pnpm-workspace.yaml",
		"*.mdx",
		"/content",
		"/public",
		"/e2e/snapshots"
	]
}
