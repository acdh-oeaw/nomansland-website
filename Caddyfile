:3000 {
	root * /usr/share/caddy

	@basePath expression `{http.request.uri.path} == "{$APP_BASE_PATH}" && "{$APP_BASE_PATH}" != ""`
	redir @basePath {$APP_BASE_PATH}/ 308

	handle_path {$APP_BASE_PATH}/* {
		header /_astro/* Cache-Control "public, max-age=31536000, immutable"

		try_files {path} {path}/
		file_server
	}

	handle /health {
		respond "OK" 200
	}

	handle {
		error 404
	}

	handle_errors {
		rewrite * /{err.status_code}.html
		file_server
	}
}
